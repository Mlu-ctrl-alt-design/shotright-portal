# Frappe bench the portal talks to.
VITE_FRAPPE_URL=https://shotright.thedaystar.co.za

# Base URL the axios client prefixes onto every call.
# Leave empty in dev so requests go to /api/... and hit the Vite proxy above
# (same-origin -> no CORS, no SameSite cookie problems).
# Set to the full bench URL only if you are deliberately going cross-origin,
# in which case the bench also needs allow_cors in common_site_config.json.
VITE_API_BASE=

# Serve in-memory fixtures instead of the real bench. LOCAL DEV ONLY — this is
# ignored by any production build (see USE_MOCKS in src/services/api.js), so
# setting it in Vercel or any other hosting dashboard does nothing.
#
# It used to work the other way round: mocks were ON unless explicitly disabled,
# in EVERY environment. The deployed portal therefore showed partners invented
# venues out of mockBackend.js as though they were their own listings. Leave
# this unset unless you are deliberately working offline.
#
# VITE_USE_MOCKS=true

# Smart defaults on "Enter your venue's details" (docs/SMART-DEFAULTS.md).
# `on` (default), `off`, or `50` for the A/B in the handoff spec §12.
# Bucketing at 50 is a deterministic hash of the account email, so a partner
# stays in one arm across sessions.
#
# NOTE: the A/B cannot be READ until analytics.js has a destination — the events
# are emitted and nothing records them.
#
# VITE_SMART_DEFAULTS=on

# Where "Contact support" on the declined-venue screen sends a partner.
#
# NOT DEFAULTED, on purpose. Every invented string on this project became a bug
# that reached a partner, and a guessed support address is the worst of them: a
# message to it does not bounce loudly, it just never gets read. With this
# unset, the screen shows no support button and says plainly that we have no
# address wired in — which is annoying, and true.
#
# VITE_SUPPORT_EMAIL=support@example.co.za

# Google OAuth client ID for "Sign in with Google" on the login and register
# screens. The bench half of this has been live and working since 5 Sep; this
# variable is the whole of what was missing.
#
# ⚠️ READ THIS BEFORE DEBUGGING A MISSING BUTTON. Vite INLINES this at build
# time. Unset, `GOOGLE_CLIENT_ID` folds to `""`, the `if (!GOOGLE_CLIENT_ID)
# return null` guard in GoogleSignInButton.jsx becomes constant-true, and the
# whole component — script load, `google.accounts.id.initialize`, the button
# itself — is tree-shaken out. The deployed chunk was 249 bytes of a function
# that returns null on every path. There is no console error and no network
# request, because there is no code left to make one: it looks exactly like a
# feature nobody built, and for three weeks it was mistaken for one.
#
# Setting it in the Vercel dashboard is not enough on its own — a build must run
# afterwards, or the old inlined "" is still what ships.
#
# Must MATCH a client ID the bench accepts, or every sign-in fails `aud`
# verification. The bench reads its list from the `shotright_google_client_ids`
# site_config key plus the `Social Login Key` record. See docs/DEPLOYMENT.md.
#
# VITE_GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Google Maps JavaScript API key, for the wizard's map picker and address
# autocomplete.
#
# Inlined at build time exactly like the client ID above, and fails the same
# quiet way: `googleMapsConfigured()` returns false, the map never loads, and
# the partner gets the manual-coordinates fallback with no indication that a
# map was meant to be there. A venue without coordinates is invisible to the
# radius search customers actually use, so this one costs listings.
#
# Needs Maps JavaScript API AND Places API enabled on the Google Cloud project,
# and should be restricted by HTTP referrer to the portal's own domains.
#
# VITE_GOOGLE_MAPS_API_KEY=AIza...
